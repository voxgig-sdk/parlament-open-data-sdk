# Entity: session

main: kit: entity: session: {

  alias: field: {}

  fields: [
    {
      name: "abbreviation"
      req: false
      short: "Session abbreviation"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "endDate"
      req: false
      short: "Session end date"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique session identifier"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Session name"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "startDate"
      req: false
      short: "Session start date"
      type: "`$STRING`"
    }
    {
      name: "state"
      req: false
      short: "Current state of the session"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of session (e.g., ordinary, extraordinary)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "session"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "json"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "de"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "session_id"
                orig: "session_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/sessions"
          segments: [
            {
              lit: "sessions"
            }
          ]
          select: {
            exist: [
              "format"
              "language"
              "session_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.sessions`"
          }
        }
      ]
    }
  }



}
